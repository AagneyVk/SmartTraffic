<configuration>
  <input>
    <net-file value="physics.net.xml"/>
    <route-files value="physics.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="600"/>
    <step-length value="1"/>
  </time>
  <processing>
    <collision.action value="warn"/>
    <time-to-teleport value="-1"/>
  </processing>
  <report>
    <no-step-log value="true"/>
    <duration-log.disable value="true"/>
  </report>
</configuration>
